[Unit]
Description=USB audio transcription cycle after a media mount

[Service]
Type=oneshot
UMask=0077
# Give the mount a moment to settle, then wait for any timer-started cycle to
# finish so the new recordings are handled by this run, not the next poll.
ExecStartPre=/bin/sleep 5
ExecStart=@CYCLE_COMMAND@ --wait
Nice=10
IOSchedulingClass=idle
