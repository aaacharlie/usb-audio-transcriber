# Copy this file to config.env and customize paths/settings for your account.
# Do not commit config.env: it may contain an API key.
ARCHIVE_DIR="${HOME}/usb-audio-transcriber-data/archive"
QUEUE_DIR="${HOME}/usb-audio-transcriber-data/queue"
STATE_DB="${HOME}/usb-audio-transcriber-data/state/seen.sqlite"
VAULT_DIR="${HOME}/usb-audio-transcriber-data/transcripts"

# File discovery. The recorder folder is matched by directory name on removable media.
AUDIO_EXTS="mp3,wav,m4a"
RECORDER_DIR="RECORD"

# Safety default: never delete source files from USB media.
PURGE_DEVICE=0

# Optional extra folders to scan for recordings, colon-separated and searched
# recursively: phone voice memos synced with Syncthing/Nextcloud/Dropbox, a
# network share, or any folder you drop audio into. Files found here are never
# deleted, even with PURGE_DEVICE=1. Example: "${HOME}/Sync/VoiceMemos:/srv/audio"
WATCH_DIRS=""

# Faster-Whisper profile: fast, accurate, or both.
# fast: distil-large-v3; much quicker and smaller, with strong English accuracy.
# accurate: large-v3; slower and ~2.9 GiB on disk, but more robust on hard audio.
# both: run an A/B comparison and keep profile-labelled outputs from each model.
WHISPER_MODEL_PROFILE="fast"
# Legacy/custom model override (used only when WHISPER_MODEL_PROFILE is empty).
WHISPER_MODEL="distil-large-v3"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE="int8"
WHISPER_LANG="en"
# Whisper task: transcribe (default) or translate (translate straight to English).
WHISPER_TASK="transcribe"
VAD_ENABLED=1
VAD_MIN_SILENCE_MS=1200

# Optional speaker labels ("Speaker 1: ..."). Needs ./install.sh --with-diarization
# (installs PyTorch), a Hugging Face read token, and accepting the terms of
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0 on huggingface.co.
# Runs locally; slow on CPU. Min/max speaker counts are optional hints.
DIARIZATION=0
HF_TOKEN=""
DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"
DIARIZATION_MIN_SPEAKERS=""
DIARIZATION_MAX_SPEAKERS=""

# Desktop integration. HEADLESS=auto shows the progress window only when a
# graphical session and zenity are available; 1 never shows it (servers,
# Raspberry Pi); 0 always tries.
HEADLESS="auto"
# NOTIFY=auto sends a desktop notification when notes are ready (click it to
# open the note or folder) whenever a graphical session and notify-send exist;
# 1 always tries; 0 never.
NOTIFY="auto"
# Control panel: the "USB Audio Transcriber" entry in your app menu, or
# bin/panel.py open. 127.0.0.1 keeps it on this machine; 0.0.0.0 lets other
# devices on your network open it with the private link from: bin/panel.py url
PANEL_BIND="127.0.0.1"
PANEL_PORT=8765

# AI summaries are optional. Transcription is always local. SUMMARY_BACKEND
# picks how summaries are made:
#   none        no summaries
#   command     pipe the prompt into a command-line AI tool you already pay for
#               and read its reply: Codex (ChatGPT plan), Claude Code, Gemini CLI,
#               your own agent...
#   openai      any OpenAI-compatible server, e.g. Ollama on this machine (free)
#   openrouter  OpenRouter, pay per use, needs OPENROUTER_API_KEY
# Empty means openrouter when a key is set, otherwise none. Try your choice with:
#   sessions.py test-backend
SUMMARY_BACKEND=""

# command backend. The prompt arrives on stdin; the summary is read from stdout,
# or from {output_file} when the command mentions it. {prompt_file} holds the
# prompt for tools that want it as an argument. Use full paths if the tool is
# not on the background service's PATH. Recipes (check each tool's --help):
#   codex exec --skip-git-repo-check --sandbox read-only --output-last-message {output_file}
#   claude -p --output-format text
#   gemini -p "$(cat {prompt_file})"
SUMMARY_COMMAND=""
SUMMARY_COMMAND_TIMEOUT=900

# openai backend. Defaults fit Ollama; pull a model first: ollama pull llama3.1:8b
LLM_BASE_URL="http://127.0.0.1:11434/v1"
LLM_MODEL=""
LLM_API_KEY=""

# openrouter backend. With a key, transcript text (never audio) is sent to OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"
MAP_WINDOW_CHARS=80000
# Per-recording summary block at the top of each transcript note.
FILE_SUMMARY=1

# Session notes. Recordings closer together than SESSION_GAP_MIN minutes are
# grouped into one "<date> <time> session.md" note that links every transcript
# and stitches them into one combined transcript, in order. Works without a key.
SESSION_NOTES=1
SESSION_GAP_MIN=20
# On an installation with history, sessions that ended more than this many
# days ago get a note but no automatic AI summary, so the first cycle after an
# update does not summarize months of recordings at once. Run
# "sessions.py retry" to summarize them on demand. Empty summarizes everything.
SESSION_BACKFILL_DAYS=7
# With an OpenRouter key, each session note also gets an AI summary generated
# from prompts/session-summary.md. Pick a strong model here; the per-file
# OPENROUTER_MODEL can stay small and cheap. Empty means "same as OPENROUTER_MODEL".
SESSION_SUMMARY=1
SESSION_SUMMARY_MODEL=""
# Subject matter inserted into the summary prompt, e.g. "commercial real estate".
SESSION_SUBJECT=""
# Custom prompt template containing {subject}; empty uses the bundled prompt.
SESSION_PROMPT_FILE=""
